<div class="text-center my-3">
  <div class="d-inline-block text-start">
    <h1>Editing Book</h1>
    <% if @book.errors.any? %>
      <div class= "error-box">
        <div class= "error-title">
          <%= @book.errors.count %>errors prohibited this book from being saved:
        </div>
        <ul>
          <% @book.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @book do |f| %>
      <div class="mb-3">
        <label for="inputTitle">Title</label><br>
        <%= f.text_field :title, autofocus: true, id:"inputTitle", class: "form-control"  %>
      </div>
      <div class="mb-3">
        <label for="inputBody">Opinion</label><br>
        <%= f.text_area :body, autofocus: true, id:"inputBody", class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= f.submit "Update Book", class: "btn", 
            style: "background-color: #008000; color: white;" %><br>
      </div>

    <%= link_to "show", book_path(@book.id) %> | <%= link_to "Back", books_path %>
    <% end %>
  </div>
</div>