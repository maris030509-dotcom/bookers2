<div class="container">
  <div class="row"> 
    <div class="col-md-3">
      <%= render "shared/sidebar", user: current_user, book: Book.new %>
    </div>

    <div class="col-md-8 offset-md-1">
      <h2>Books</h2>

      <% if @book.errors.any? %>
        <ul>
          <% @book.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      <% end %>

      <table class="table bg-white">
        <thead>
          <tr class="border-top border-bottom">
            <th class="fw-bolder p-2"></th>
            <th class="fw-bolder p-2">Title</th>
            <th class="fw-bolder p-2">Opinion</th>
            <th class="fw-bolder p-2"></th>
            <th class="fw-bolder p-2"></th>
          </tr>
        </thead>

        <tbody>
          <% @books.each do |book| %>
            <tr class="border-top border-bottom">
              <td class="fw-bolder p-2">
                <%= link_to user_path(book.user) do %>
                  <%= image_tag book.user.get_profile_image(80,80) %>
                <% end %>
              </td>

              <td class="fw-bolder p-2">
                <%= link_to book.title, book_path(book) %>
              </td>
        
              <td colspan="3", class="fw-bolder p-2">
                <%= book.body %></p>
              </td>
              
            <% if book.favorited_by?(Current.user) %>
              <td class="fw-bolder p-2">
                <%= link_to book_favorite_path(book), data: { turbo_method: :delete } do %>
                  ♥<%= book.favorites.count %> いいね
                <% end %>
              </td>
            <% else %>
              <td class="fw-bolder p-2">
                <%= link_to book_favorite_path(book), data: { turbo_method: "post" } do %>
                  ♡<%= book.favorites.count %> いいね
                <% end %>
              </td>
            <% end %>

              <td>
                コメント数：<%= book.book_comments.count %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table> 
    </div>
  </div>
</div>