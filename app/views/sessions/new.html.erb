<%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<h1>Log in</h1>
<%= form_with url: session_path do |form| %>
  <p>Name</p>
  <%= form.text_field :name, required: true, autofocus: true, autocomplete: "username",  value: params[:name] ,minlength: 2 ,maxlength: 20 %><br>
  <p>Password</p>
  <%= form.password_field :password, required: true, autocomplete: "current-password",  maxlength: 20 %><br>
  <%= form.submit "Log in" %>
<% end %>
<br>

<%= link_to "Sign up", new_user_path %><br>
<%= link_to "Forgot password?", new_password_path %>
