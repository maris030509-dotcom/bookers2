<% @sidebar_user = current_user %>
<% @sidebar_book = Book.new %>

<h2>Users</h2>

<table class="table bg-white">
  <thead>
    <tr class="border-top border-bottom">
      <th class="fw-bolder p-2">image</th>
      <th class="fw-bolder p-2">name</th>
      <th class="fw-bolder p-2"></th>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
      <tr class="border-top border-bottom">
        <td class="fw-bolder p-2">
          <%= image_tag user.get_profile_image(100, 100), class: "profile-img" %>
        </td>
        <td class="fw-bolder p-2">
          <%= user.name %>
        </td>
        <td class="fw-bolder p-2">
          <%= link_to "show", user_path(user) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>