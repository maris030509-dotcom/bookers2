<div class="col-md-3">
  <%= render "shared/sidebar", user: current_user, book: Book.new %>
</div>

<div class="col-md-8 offset-md-1">
  <h2>Books</h2>

  <table class="table bg-white">
    <thead>
      <tr class="border-top border-bottom">
        <th class="fw-bolder p-2"></th>
        <th class="fw-bolder p-2">Title</th>
        <th class="fw-bolder p-2">Opinion</th>
      </tr>
    </thead>
    <tbody>
      <% @books.each do |book| %>
        <tr class="border-top border-bottom">
          <td class="fw-bolder p-2">
            <%= link_to user_path(book.user) do %>
              <%= image_tag book.user.get_profile_image(80,80) %>
            <% end %>
          </td>

          <td class="fw-bolder p-2">
            <%= link_to book.title, book_path(book) %>
          </td>
          <td colspan="3", class="fw-bolder p-2 w-50">
            <%= book.body %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>