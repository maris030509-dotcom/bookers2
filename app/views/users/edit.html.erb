<div class="text-center my-3">
  <div class="d-inline-block text-start">

    <h1>User info</h1>
    <% if @user.errors.any? %>
      <div class="error-box">
        <div class="error-title">
          <%= @user.errors.count %> errors prohibited this user from being saved:
        </div>
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    
    <%= form_with model: @user do |f| %>
      <div class="mb-3">
        <label for="inputName">Name</label><br>
        <%= f.text_field :name, autofocus: true, id:"inputName", class: "form-control" %>
      </div>
      
      <div class="mb-3">
        <label for="inputImage">Image</label><br>
        <%= f.file_field :profile_image, accept: "image/*" %>
      </div>

      <div class="mb-3">
        <label for="inputIntroduce">Introduction</label><br>
        <%= f.text_area :introduction, autofocus: true, id:"inputIntroduce", maxlength: 50, class: "form-control" %>
      </div>

      <%= f.submit "Update User", class: "btn", style: "background-color: #6c757d; color: white;" %>
    <% end %>
  </div>
</div>